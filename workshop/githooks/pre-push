# Block pushes that contain confidential workshop data. See AGENTS.md.
root=$(git rev-parse --show-toplevel)
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_sha" in *[!0]*) ;; *) continue ;; esac   # branch deletion
    python3 "$root/workshop/guard/confidential_guard.py" push "$1" "$local_sha" || status=1
done
exit $status
